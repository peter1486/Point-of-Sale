        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
 var total = 0; // Inicializar total como número
    var orderItems = new GlideRecord('x_68761_point_of_s_order_items_mtom');
    orderItems.addQuery('order', current.sys_id);
    orderItems.query();

    while (orderItems.next()) {
        var subtotal = parseFloat(orderItems.subtotal) || 0;
        total += subtotal;
        
       
    }

    current.total = Math.round(total * 100) / 100;

})(current, previous);]]></script>
